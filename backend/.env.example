# MongoDB connection string
# URL-encode special characters in the username or password.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quantum_app?retryWrites=true&w=majority

# Backend port
PORT=5000

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Set to true when running as a Vercel function
# VERCEL=true
